<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%-5level %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <!-- resilience4j-micronaut logs every failure of a protected method at ERROR, with its stack trace: off, so that
         the benchmark measures the library and not the console (MicronautBenchmark's Javadoc). -->
    <logger name="io.github.resilience4j.micronaut.BaseInterceptor" level="off"/>
    <root level="warn"><appender-ref ref="STDOUT"/></root>
</configuration>
